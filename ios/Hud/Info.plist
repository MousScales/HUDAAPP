    <array>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>huda</string>
        </array>
      </dict>
      <dict>
        <key>CFBundleURLSchemes</key>
        <array>
          <string>exp+huda-app</string>
        </array>
      </dict>
    </array>
    <key>CFBundleVersion</key>
    <string>1.10.1</string>
