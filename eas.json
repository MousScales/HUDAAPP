{
  "cli": {
    "version": ">= 16.6.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": { "INCLUDE_DEV_CLIENT": "true" },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "macos-sequoia-15.6-xcode-26.2"
      },
      "channel": "development",
      "env": { "INCLUDE_DEV_CLIENT": "true" }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": { "INCLUDE_DEV_CLIENT": "false" },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2",
        "resourceClass": "m-medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "env": { "INCLUDE_DEV_CLIENT": "false" },
      "ios": {
        "image": "macos-sequoia-15.6-xcode-26.2"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
