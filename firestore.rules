rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isHuddaCreator() {
      return request.auth != null
        && request.auth.uid == 'xP5Wza4BXeOoEE4g0vYyi7ftwzu1';
    }
    // Temporary rules for lesson migration - CHANGE AFTER UPLOAD
    match /lessons/{lessonId} {
      allow read, write: if true; // Temporarily allow all writes for upload
    }
    
    // AFTER LESSON UPLOAD, replace above with these secure rules:
    // match /lessons/{lessonId} {
    //   allow read: if true; // Anyone can read lessons
    //   allow write: if false; // Only admins should write lessons
    // }
    
    // Allow connectivity tests (needed for network diagnostics)
    match /connectivity-test/{document} {
      allow read: if true; // Allow unauthenticated connectivity tests
    }
    
    // User data - only authenticated users can access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Private donation admin records — server/functions only
    match /donationRecords/{recordId} {
      allow read, write: if false;
    }

    // Community dua board — anyone can read; signed-in users can post and interact
    match /duaBoard/{requestId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null;
        allow update: if request.auth != null && (
          (
            resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isCreator', 'authorEmail'])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['supporters'])
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reportCount', 'reportedBy'])
          )
        );
      }
    }

    // Dua like notifications — created by clients, processed by Cloud Functions
    match /duaLikeNotifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Public supporter wall — anyone can read; signed-in users can update likes only
    match /publicDonations/{donationId} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if request.auth != null
        && resource.data.visibleOnWall == true
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'likeCount', 'creatorLiked'])
        && (
          !(request.resource.data.diff(resource.data).affectedKeys().hasAny(['creatorLiked']))
          || isHuddaCreator()
        );
    }
    
    // Other collections (keep existing rules)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
} 